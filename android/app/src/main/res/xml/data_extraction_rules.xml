<?xml version="1.0" encoding="utf-8"?>
<!--
  No Android backup of any kind. On API 31+ android:allowBackup="false" only
  stops cloud backup; device-to-device transfer still runs unless excluded
  here. Both would carry the session token and the whole finance DB — the
  app's own SAF folder backup is the only supported path.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
